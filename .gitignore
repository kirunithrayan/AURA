# Secrets & Signing
# AURA holds the Gemini API key in the Android Keystore at runtime, so no key
# belongs in the repo. These patterns exist to keep it that way.
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
google-services.json
secrets.properties

# Logs & Temporary Files
*.log
*.tmp

# Runtime Databases
*.db
*.sqlite
*.sqlite3

# Temporary Caches
.cache/
tmp/
temp/

# DO NOT IGNORE (Explicit inclusion for documentation purposes)
# !*.g.dart
# !*.freezed.dart
